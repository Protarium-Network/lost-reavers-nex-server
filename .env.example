# Lost Reavers NEX server
#
# Copy to .env and edit. Every value can also come from the real environment;
# the .env file is only a convenience.

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

PN_LR_AUTHENTICATION_SERVER_PORT=60000
PN_LR_SECURE_SERVER_PORT=60001

# Address the CONSOLE should use to reach the secure server. Written into the
# Kerberos ticket and dialled verbatim: a LAN address for a console on your
# network, a public address / domain for a console on the internet.
PN_LR_SECURE_SERVER_HOST=192.168.1.10

# ---------------------------------------------------------------------------
# Access key -- REQUIRED, no default. Read docs/ACCESS_KEY.md first.
# ---------------------------------------------------------------------------

# Lost Reavers is missing from both kinnay's NEX server list
# (https://kinnay.github.io/view.html?page=nexwiiu) and Pretendo's
# nex-viewer access.txt, and the key is not a bare string in the game's
# executable either. There is no safe default: starting with a wrong guess
# makes every console packet get silently discarded, with no error logged at
# all. See docs/ACCESS_KEY.md for how to capture and confirm the real one.
#PN_LR_ACCESS_KEY=

# Best-guess placeholder -- override once a real capture confirms the actual
# NEX build (docs/ACCESS_KEY.md again).
PN_LR_NEX_VERSION_MAJOR=3
PN_LR_NEX_VERSION_MINOR=9
PN_LR_NEX_VERSION_PATCH=0

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

PN_LR_POSTGRES_URI=postgres://lostreavers:lostreavers@localhost:5432/lostreavers?sslmode=disable

# ---------------------------------------------------------------------------
# DataStore object storage (required) -- treasure/inventory blobs
# ---------------------------------------------------------------------------

# Any S3-compatible endpoint works; `docker compose up` runs a MinIO instance
# for you (see compose.yaml) with these exact values.
PN_LR_S3_ENDPOINT=localhost:9000
PN_LR_S3_REGION=us-east-1
PN_LR_S3_BUCKET=lost-reavers-datastore
PN_LR_S3_ACCESS_KEY=lostreavers
PN_LR_S3_SECRET_KEY=lostreavers-datastore
PN_LR_S3_USE_SSL=0

# ---------------------------------------------------------------------------
# Accounts: pick ONE of the two blocks below
# ---------------------------------------------------------------------------

# (a) Standalone. NEX passwords are read from settings.json and login tokens
#     are not verified against anything. See settings.example.json.
PN_LR_LOCAL_AUTH=1
PN_LR_SETTINGS_FILE=settings.json

# (b) Account server.
#PN_LR_LOCAL_AUTH=0
#PN_LR_ACCOUNT_GRPC_HOST=localhost
#PN_LR_ACCOUNT_GRPC_PORT=50051
#PN_LR_ACCOUNT_GRPC_API_KEY=

# ---------------------------------------------------------------------------
# Friends (optional, but plausibly load-bearing here -- see globals/friends.go)
# ---------------------------------------------------------------------------

#PN_LR_FRIENDS_GRPC_HOST=localhost
#PN_LR_FRIENDS_GRPC_PORT=50052
#PN_LR_FRIENDS_GRPC_API_KEY=

# ---------------------------------------------------------------------------
# Behaviour and logging
# ---------------------------------------------------------------------------

PN_LR_ALLOW_PUBLIC_MATCHMAKING=1
PN_LR_LOG_RMC=1

# Dump the GameMode, attributes and search criteria the game sends when
# looking for a party. Nobody has published a capture of Lost Reavers'
# matchmaking traffic, so leave this on: it is how the four-player lobby
# layout gets found out.
PN_LR_LOG_MATCHMAKING=1

PN_LR_VERBOSE_RMC=0

#PN_LR_HEALTH_CHECK_PORT=60002
